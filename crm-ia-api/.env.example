# =====================================================================
# IA.centrism CRM — API
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# =====================================================================

NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Banco
#
# Produção: connection string do Postgres do Supabase
#   Dashboard → Project Settings → Database → Connection string (URI)
#   Use o pooler (porta 6543) para a API.
# Desenvolvimento sem Docker: `npm run db:local` sobe um Postgres local
#   em postgres://postgres:postgres@127.0.0.1:5433/postgres (DATABASE_SSL=disable)
# ---------------------------------------------------------------------
# A API usa o Transaction pooler (6543). As migrations precisam da conexão
# direta ou do Session pooler (5432) — veja DEPLOY.md.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=10
# No Postgres local (PGlite) use 5: ele serializa as queries de qualquer forma.
DATABASE_SSL=require

# ---------------------------------------------------------------------
# Supabase
#
# ANON_KEY é pública (vai para o navegador) — a `anon`/`publishable`.
# SERVICE_ROLE_KEY ignora RLS — só no servidor, nunca no frontend.
# JWT_SECRET é opcional: valida o token localmente, sem ida à rede. Em
#   projetos que assinam com chave assimétrica (ECC/RSA) não existe segredo
#   equivalente — deixe vazio e a validação vai pelo Supabase.
#   Dashboard → Project Settings → API e → API Keys
# ---------------------------------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------
# Borda HTTP
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
